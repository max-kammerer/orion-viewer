<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <attr name="appIconTint" format="color|reference"/>
    <attr name="listHighlightColor" format="color"/>
    <attr name="navIconTint" format="color|reference"/>
    <attr name="menuIconTint" format="color|reference"/>
    <attr name="newMenuBackground" format="color|reference"/>
    <attr name="newMenuTint" format="color|reference"/>

    <dimen name="text_size_small">14sp</dimen>
    <dimen name="text_size_medium">16sp</dimen>
    <dimen name="text_size_large">18sp</dimen>

    <style name="TabNoAllCaps" parent="TextAppearance.Design.Tab">
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ViewerIconWithTint" >
        <item name="tint">?attr/menuIconTint</item>
        <item name="drawableTint">?attr/navIconTint</item>
    </style>

    <style name="Viewer_Dialog_Icon" >
        <item name="android:drawablePadding">2dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="tint">?attr/menuIconTint</item>
        <item name="drawableTint">?attr/navIconTint</item>
    </style>


    <style name="General_TextView" >
        <item name="android:textSize">18sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="General_Help_TextView" >
        <item name="android:drawablePadding">5dp</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="tint">?attr/menuIconTint</item>
        <item name="drawableTint">?attr/navIconTint</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="General_Contribution_TextView" >
        <item name="android:drawablePadding">5dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="tint">?attr/menuIconTint</item>
        <item name="drawableTint">?attr/navIconTint</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
    </style>

    <style name="New_Viewer_Menu_Item" >
<!--        <item name="android:padding">3dp</item>-->
<!--        <item name="android:background">?attr/newMenuBackground</item>-->
        <item name="android:layout_margin">3dp</item>
        <item name="android:paddingLeft">3dp</item>
        <item name="android:paddingRight">3dp</item>
        <item name="android:width">32dp</item>
        <item name="android:height">32dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="tint">?attr/newMenuTint</item>
    </style>

    <style name="Tap_Dialog_Top" >
        <item name="android:gravity">center</item>
        <item name="android:layout_alignParentTop">true</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
    </style>

    <style name="Tap_Dialog_Bottom" parent="Tap_Dialog_Top" >
        <item name="android:layout_alignParentTop">false</item>
        <item name="android:layout_alignParentBottom">true</item>
    </style>

    <style name="Tap_Dialog_Cell" >
        <item name="android:layout_width">0px</item>
        <item name="android:layout_height">fill_parent</item>
        <item name="android:layout_margin">1dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@color/orion_orange</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="OrionActionBar" parent="@style/Widget.AppCompat.Toolbar">
        <item name="android:background">@color/orion_blue</item>
    </style>

    <!-- Paper-colored toolbar for the light theme, ink title/controls -->
    <style name="OrionActionBar.Light">
        <item name="android:background">@color/paper_chrome</item>
        <item name="titleTextColor">@color/ink</item>
    </style>

    <!-- Blue toolbar on the classic light theme needs light controls/title on it -->
    <style name="OrionActionBar.Classic">
        <item name="android:theme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="titleTextColor">@color/white</item>
    </style>

    <style name="OrionActionBar.Library">
        <item name="android:background">@color/library_surface</item>
        <item name="titleTextColor">@color/library_text</item>
    </style>

    <style name="OrionNavigation" parent="@style/Widget.Design.NavigationView">
        <item name="android:background">@color/orion_blue</item>
    </style>

    <style name="Theme.Orion.Default.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fitsSystemWindows">true</item>
        <item name="navIconTint">@color/white</item>
        <item name="appIconTint">?attr/navIconTint</item>
        <item name="menuIconTint">?attr/navIconTint</item>

        <item name="colorPrimaryDark">#54759e</item>
        <item name="actionMenuTextColor">@color/orion_blue</item>
        <item name="newMenuTint">@color/white</item>
        <item name="newMenuBackground">@color/orion_blue</item>
        <item name="actionBarStyle">@style/OrionActionBar</item>
        <item name="android:actionBarStyle">@style/OrionActionBar</item>
        <item name="toolbarStyle">@style/OrionActionBar</item>
        <item name="panelBackground">@style/OrionActionBar</item>
        <item name="navigationViewStyle">@style/OrionNavigation</item>
    </style>

    <!-- "Quiet graphite": chrome recedes behind the book page -->
    <style name="Theme.Orion.Dark.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fitsSystemWindows">true</item>
        <item name="navIconTint">@color/graphite_icon</item>
        <item name="appIconTint">?attr/navIconTint</item>
        <item name="menuIconTint">?attr/navIconTint</item>

        <item name="android:windowBackground">@color/graphite_black</item>
        <item name="android:colorBackground">@color/graphite_black</item>
        <item name="colorBackgroundFloating">@color/graphite_surface</item>
        <item name="colorAccent">@color/ochre_muted</item>
        <item name="listHighlightColor">#33D9A441</item>
        <item name="colorPrimaryDark">@color/graphite_black</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="newMenuTint">@color/white</item>
        <item name="newMenuBackground">@color/graphite_chrome</item>
    </style>

    <!-- "Paper and ink": warm paper surfaces, warm ink text -->
    <style name="Theme.Orion.Light.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fitsSystemWindows">true</item>
        <item name="navIconTint">@color/ink_icon</item>
        <item name="appIconTint">?attr/navIconTint</item>
        <item name="menuIconTint">?attr/navIconTint</item>

        <item name="android:windowBackground">@color/paper_background</item>
        <item name="android:colorBackground">@color/paper_background</item>
        <item name="colorBackgroundFloating">@color/paper_surface</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_secondary</item>
        <item name="colorAccent">@color/orion_ochre_dark</item>
        <item name="listHighlightColor">#2EB87817</item>
        <item name="colorPrimaryDark">@color/paper_status_bar</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="actionBarStyle">@style/OrionActionBar.Light</item>
        <item name="android:actionBarStyle">@style/OrionActionBar.Light</item>
        <item name="toolbarStyle">@style/OrionActionBar.Light</item>
        <item name="newMenuTint">@color/ink_icon</item>
        <item name="newMenuBackground">@color/paper_chrome</item>
    </style>

    <!-- "Library": reading-room green baize and brass -->
    <style name="Theme.Orion.Library.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fitsSystemWindows">true</item>
        <item name="navIconTint">@color/library_icon</item>
        <item name="appIconTint">?attr/navIconTint</item>
        <item name="menuIconTint">?attr/navIconTint</item>

        <item name="android:windowBackground">@color/library_background</item>
        <item name="android:colorBackground">@color/library_background</item>
        <item name="colorBackgroundFloating">@color/library_surface</item>
        <item name="android:textColorPrimary">@color/library_text</item>
        <item name="android:textColorSecondary">@color/library_text_secondary</item>
        <item name="colorAccent">@color/library_brass</item>
        <item name="listHighlightColor">#29C8A24A</item>
        <item name="colorPrimaryDark">@color/library_deep</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="actionBarStyle">@style/OrionActionBar.Library</item>
        <item name="android:actionBarStyle">@style/OrionActionBar.Library</item>
        <item name="toolbarStyle">@style/OrionActionBar.Library</item>
        <item name="newMenuTint">@color/library_text</item>
        <item name="newMenuBackground">@color/library_surface</item>
    </style>

    <!-- "Classic": neutral white with the orion_blue toolbar and ochre accent -->
    <style name="Theme.Orion.Classic.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fitsSystemWindows">true</item>
        <item name="navIconTint">@color/toolbar_icon_tint</item>
        <item name="appIconTint">?attr/navIconTint</item>
        <item name="menuIconTint">?attr/navIconTint</item>

        <item name="colorAccent">@color/orion_ochre_dark</item>
        <item name="listHighlightColor">#4D54759E</item>
        <item name="colorPrimaryDark">@color/classic_status_bar</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="actionBarStyle">@style/OrionActionBar.Classic</item>
        <item name="android:actionBarStyle">@style/OrionActionBar.Classic</item>
        <item name="toolbarStyle">@style/OrionActionBar.Classic</item>
        <item name="newMenuTint">@color/white</item>
        <item name="newMenuBackground">@color/orion_blue</item>
    </style>

    <!-- Stock system look: plain AppCompat parents, no Orion palette -->
    <style name="Theme.Orion.Android.Dark.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fitsSystemWindows">true</item>
        <item name="navIconTint">?attr/colorControlNormal</item>
        <item name="appIconTint">?attr/navIconTint</item>
        <item name="menuIconTint">?attr/navIconTint</item>

        <item name="newMenuTint">?attr/navIconTint</item>
        <item name="newMenuBackground">?attr/colorPrimary</item>
    </style>

    <style name="Theme.Orion.Android.Light.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fitsSystemWindows">true</item>
        <item name="navIconTint">?attr/colorControlNormal</item>
        <item name="appIconTint">?attr/navIconTint</item>
        <item name="menuIconTint">?attr/navIconTint</item>

        <item name="newMenuTint">?attr/navIconTint</item>
        <item name="newMenuBackground">?attr/colorPrimary</item>
    </style>

</resources>
