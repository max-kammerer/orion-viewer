 		subarea->y1 = image->h;
 }
 
+/* Bytes per pixel of the pixmap a decode of this image produces: indexed
+ * images are expanded to their base space, a color key adds alpha, an image
+ * mask is alpha only. */
+static int decoded_pixel_size(fz_context *ctx, fz_image *image)
+{
+	fz_colorspace *cs = image->colorspace;
+	int n;
+
+	if (cs == NULL)
+		return 1;
+	if (fz_colorspace_is_indexed(ctx, cs))
+		cs = fz_base_colorspace(ctx, cs);
+	n = fz_colorspace_n(ctx, cs);
+	if (image->use_colorkey)
+		n++;
+	return n;
+}
