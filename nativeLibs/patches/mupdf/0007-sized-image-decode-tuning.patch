+/**
+	Like fz_tune_image_decode_fn, but also told how big the decoded
+	pixmap will be: n is the number of bytes per decoded pixel
+	(components plus alpha; 1 for an image mask). This lets a tuning
+	function bound the memory a whole-image decode would take, which
+	w, h and l2factor alone can't tell for gray vs color images.
+*/
+typedef void (fz_tune_image_decode_sized_fn)(void *arg, int w, int h, int n, int l2factor, fz_irect *subarea);
+
+/**
+	Set a sized tuning function for image decode. When set, it is
+	used instead of the one given to fz_tune_image_decode. Pass NULL
+	to go back to that one.
+*/
+void fz_tune_image_decode_sized(fz_context *ctx, fz_tune_image_decode_sized_fn *image_decode, void *arg);
+
 /**
