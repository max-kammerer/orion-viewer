+/* 32 bit Android: before API 24 there is no fseeko64/ftello64, so builds for
+ * older versions keep a 32 bit off_t and stdio can't seek past 2 GB. Files
+ * that big are read with read() and lseek64() on the descriptor instead,
+ * bypassing stdio and its buffer; smaller files keep the stdio path. */
+#if defined(__ANDROID__) && !defined(__LP64__)
+#define FZ_FILE_LARGE_FALLBACK
+#include <sys/stat.h>
+#endif
+
