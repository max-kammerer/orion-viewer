+// Artifex Software, Inc., 39 Mesa Street, Suite 108A, San Francisco,
+// CA 94129, USA, for further information.
+
+#include "mupdf/fitz.h"
+
+#include "image-imp.h"
+
+#ifdef HAVE_WEBP
+
+#include <webp/decode.h>
+
+/* WebP carries no resolution, so the usual default applies, as for GIF and PNG without pHYs. */
+#define WEBP_RES 96
+
+static void
+webp_read_features(fz_context *ctx, const unsigned char *data, size_t size, WebPBitstreamFeatures *features)
+{
+	VP8StatusCode status = WebPGetFeatures(data, size, features);
+	if (status != VP8_STATUS_OK)
+		fz_throw(ctx, FZ_ERROR_FORMAT, "cannot read webp header (status %d)", status);
+	if (features->width <= 0 || features->height <= 0)
+		fz_throw(ctx, FZ_ERROR_FORMAT, "invalid webp dimensions");
+	if (features->has_animation)
+		fz_throw(ctx, FZ_ERROR_UNSUPPORTED, "animated webp is not supported");
+}
+
+fz_pixmap *
+fz_load_webp(fz_context *ctx, const unsigned char *data, size_t size)
+{
+	WebPBitstreamFeatures features;
+	WebPDecoderConfig config;
+	VP8StatusCode status;
+	fz_pixmap *pix;
+	int alpha;
+
+	webp_read_features(ctx, data, size, &features);
+	if (!WebPInitDecoderConfig(&config))
+		fz_throw(ctx, FZ_ERROR_LIBRARY, "webp decoder version mismatch");
+
+	alpha = features.has_alpha;
+	pix = fz_new_pixmap(ctx, fz_device_rgb(ctx), features.width, features.height, NULL, alpha);
+	pix->xres = WEBP_RES;
+	pix->yres = WEBP_RES;
+
+	/* Decoded straight into the pixmap; mupdf keeps alpha premultiplied, hence rgbA. */
+	config.output.colorspace = alpha ? MODE_rgbA : MODE_RGB;
+	config.output.is_external_memory = 1;
+	config.output.u.RGBA.rgba = pix->samples;
+	config.output.u.RGBA.stride = (int)pix->stride;
+	config.output.u.RGBA.size = (size_t)pix->stride * pix->h;
+
+	status = WebPDecode(data, size, &config);
+	if (status != VP8_STATUS_OK)
+	{
+		fz_drop_pixmap(ctx, pix);
+		fz_throw(ctx, FZ_ERROR_FORMAT, "cannot decode webp image (status %d)", status);
+	}
+
+	return pix;
+}
+
+void
+fz_load_webp_info(fz_context *ctx, const unsigned char *data, size_t size, int *wp, int *hp, int *xresp, int *yresp, fz_colorspace **cspacep)
+{
+	WebPBitstreamFeatures features;
+
+	webp_read_features(ctx, data, size, &features);
+	*wp = features.width;
+	*hp = features.height;
+	*xresp = WEBP_RES;
+	*yresp = WEBP_RES;
+	*cspacep = fz_keep_colorspace(ctx, fz_device_rgb(ctx));
+}
+
+#else /* HAVE_WEBP */
+
+fz_pixmap *
+fz_load_webp(fz_context *ctx, const unsigned char *data, size_t size)
+{
+	fz_throw(ctx, FZ_ERROR_UNSUPPORTED, "WebP codec is not available");
+}
+
+void
+fz_load_webp_info(fz_context *ctx, const unsigned char *data, size_t size, int *wp, int *hp, int *xresp, int *yresp, fz_colorspace **cspacep)
+{
+	fz_throw(ctx, FZ_ERROR_UNSUPPORTED, "WebP codec is not available");
+}
+
+#endif /* HAVE_WEBP */
