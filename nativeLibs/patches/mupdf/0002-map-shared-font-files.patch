+#else
+fz_buffer *
+fz_new_buffer_from_mapped_file(fz_context *ctx, const char *filename)
+{
+	fz_buffer *b;
+	int fd;
+	struct stat st;
+	void *map;
+
+	fd = open(filename, O_RDONLY);
+	if (fd < 0)
+		return NULL;
+	if (fstat(fd, &st) < 0 || st.st_size <= 0)
+	{
+		close(fd);
+		return NULL;
+	}
+	map = mmap(NULL, (size_t)st.st_size, PROT_READ, MAP_PRIVATE, fd, 0);
+	close(fd);
+	if (map == MAP_FAILED)
+		return NULL;
+
+	fz_try(ctx)
+		b = fz_malloc_struct(ctx, fz_buffer);
+	fz_catch(ctx)
+	{
+		munmap(map, (size_t)st.st_size);
+		fz_rethrow(ctx);
+	}
+	b->refs = 1;
+	b->data = map;
+	b->cap = (size_t)st.st_size;
+	b->len = (size_t)st.st_size;
+	b->unused_bits = 0;
+	/* Marked shared so no existing code path writes to or frees the
+	 * data; the unmap on drop is the only new behaviour. */
+	b->shared = 1;
+	b->mapped = 1;
+	return b;
+}
+#endif
