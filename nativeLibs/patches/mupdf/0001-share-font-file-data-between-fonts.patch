+static fz_buffer *
+lookup_shared_font_file(fz_context *ctx, const char *path)
+{
+	fz_buffer *buffer = NULL;
+	int i;
+
+	fz_lock(ctx, FZ_LOCK_GLYPHCACHE);
+	/* Entries are only ever appended, so the first empty one ends the table. */
+	for (i = 0; i < (int)nelem(ctx->font->file) && ctx->font->file[i].buffer; ++i)
+	{
+		if (!strcmp(ctx->font->file[i].path, path))
+		{
+			buffer = fz_keep_buffer(ctx, ctx->font->file[i].buffer);
+			break;
+		}
+	}
+	fz_unlock(ctx, FZ_LOCK_GLYPHCACHE);
+
+	return buffer;
+}
+
+/* Publishes buffer under path, or adopts the one another thread published
+   meanwhile. Takes ownership of path and of the caller's reference to buffer,
+   and returns the reference the caller keeps. */
+static fz_buffer *
+publish_shared_font_file(fz_context *ctx, char *path, fz_buffer *buffer)
+{
+	fz_buffer *shared = NULL;
+	int i;
+
+	fz_lock(ctx, FZ_LOCK_GLYPHCACHE);
+	for (i = 0; i < (int)nelem(ctx->font->file); ++i)
+	{
+		if (!ctx->font->file[i].buffer)
+		{
+			ctx->font->file[i].path = path;
+			ctx->font->file[i].buffer = fz_keep_buffer(ctx, buffer);
+			path = NULL;
+			break;
+		}
+		if (!strcmp(ctx->font->file[i].path, path))
+		{
+			shared = fz_keep_buffer(ctx, ctx->font->file[i].buffer);
+			break;
+		}
+	}
+	fz_unlock(ctx, FZ_LOCK_GLYPHCACHE);
+
+	fz_free(ctx, path);
+	if (shared)
+	{
+		fz_drop_buffer(ctx, buffer);
+		return shared;
+	}
+
+	return buffer;
+}
+
+fz_font *
+fz_new_font_from_shared_file(fz_context *ctx, const char *name, const char *path, int index, int use_glyph_bbox)
+{
+	fz_buffer *buffer;
+	fz_font *font = NULL;
+
+	buffer = lookup_shared_font_file(ctx, path);
+	if (!buffer)
+	{
+		char *key = fz_strdup(ctx, path);
+
+		fz_try(ctx)
+			buffer = fz_read_file(ctx, path);
+		fz_catch(ctx)
+		{
+			fz_free(ctx, key);
+			fz_rethrow(ctx);
+		}
+
+		buffer = publish_shared_font_file(ctx, key, buffer);
+	}
+
+	fz_try(ctx)
+		font = fz_new_font_from_buffer(ctx, name, buffer, index, use_glyph_bbox);
+	fz_always(ctx)
+		fz_drop_buffer(ctx, buffer);
+	fz_catch(ctx)
+		fz_rethrow(ctx);
+
+	return font;
+}
