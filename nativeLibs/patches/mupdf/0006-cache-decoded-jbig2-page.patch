+/* A decoded jbig2 page bitmap (packed 1bpp), cached in the store keyed by
+ * the raw compressed data buffer. jbig2 has no random access: any subarea or
+ * subsampled request costs a full page decode, so tiled rendering used to
+ * decode the same page once per tile. The packed page is 8 pixels per byte -
+ * 8x smaller than the expanded pixmap - and turns repeats into row copies.
+ *
+ * Memory: the page is cached on every decode, at full resolution. When the
+ * image decode tuning expands a tile request to the whole image (orion_image_decode
+ * in Orion), the downsampled full pixmap is cached too and serves all tiles, so
+ * at small zoom the packed copy is mostly redundant and can be larger than that
+ * pixmap (a 600 dpi A4 page: ~4.4 MB packed vs ~2 MB at l2factor 2, ~0.5 MB at 3).
+ * It only pays off when the l2factor changes (zoom across a power of two) or
+ * when the image is too big to be decoded whole. If the store gets tight, cache
+ * the packed page only for subarea requests (decide in compressed_image_get_pixmap,
+ * which knows the subarea) or only when it is not bigger than the pixmap at the
+ * requested l2factor. */
+typedef struct
+{
+	fz_storable storable;
+	fz_buffer *data;
+} fz_jbig2_page;
+
+static void
+fz_drop_jbig2_page_imp(fz_context *ctx, fz_storable *storable)
+{
+	fz_jbig2_page *page = (fz_jbig2_page *)storable;
+	fz_drop_buffer(ctx, page->data);
+	fz_free(ctx, page);
+}
+
+static int
+fz_jbig2_page_make_hash_key(fz_context *ctx, fz_store_hash *hash, void *key)
+{
+	hash->u.pi.ptr = key;
+	hash->u.pi.i = 0;
+	return 1;
+}
+
+static void *
+fz_jbig2_page_keep_key(fz_context *ctx, void *key)
+{
+	return fz_keep_buffer(ctx, key);
+}
+
+static void
+fz_jbig2_page_drop_key(fz_context *ctx, void *key)
+{
+	fz_drop_buffer(ctx, key);
+}
+
+static int
+fz_jbig2_page_cmp_key(fz_context *ctx, void *k0, void *k1)
+{
+	return k0 == k1;
+}
+
+static void
+fz_jbig2_page_format_key(fz_context *ctx, char *s, size_t n, void *key)
+{
+	fz_snprintf(s, n, "(jbig2 page %p)", key);
+}
+
+static const fz_store_type fz_jbig2_page_store_type =
+{
+	"fz_jbig2_page",
+	fz_jbig2_page_make_hash_key,
+	fz_jbig2_page_keep_key,
+	fz_jbig2_page_drop_key,
+	fz_jbig2_page_cmp_key,
+	fz_jbig2_page_format_key,
+	NULL
+};
+
