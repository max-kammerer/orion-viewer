+	}
 	x = state->idx;
 	while (p < ep && x < w)
 		*p++ = s[x++] ^ 0xff;
@@ -218,6 +334,12 @@ fz_drop_jbig2_globals_imp(fz_context *ctx, fz_storable *globals_)
 
