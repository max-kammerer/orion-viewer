+/* The usual case for scanned pages: every component is 8 bit unsigned,
+ * the size of the image, neither subsampled nor offset. Then each row is
+ * filled in one pass over all components, in loops the compiler turns into
+ * SIMD, instead of one strided pass per component with the subsampling and
+ * clipping logic of template_copy_comp for every sample. The bytes are the
+ * same: the generic path also stores the samples truncated to a byte.
+ * Returns 0, leaving the pixmap untouched, if the image doesn't qualify. */
+static int
+copy_jpx_to_pixmap_fast(fz_context *ctx, fz_pixmap *img, opj_image_t *jpx)
+{
+	int comps = fz_pixmap_components(ctx, img);
+	int w = img->w;
+	int h = img->h;
+	ptrdiff_t stride = fz_pixmap_stride(ctx, img);
+	int indexed = fz_colorspace_is_indexed(ctx, img->colorspace);
+	unsigned char *dst = fz_pixmap_samples(ctx, img);
+	const OPJ_INT32 *src[FZ_MAX_COLORS + 1];
+	int k, x, y;
+
+	if (comps < 1 || comps > (int)nelem(src))
+		return 0;
+	for (k = 0; k < comps; k++)
+	{
+		opj_image_comp_t *comp = &jpx->comps[k];
+		if (comp->data == NULL || comp->dx != 1 || comp->dy != 1 ||
+			comp->w != (OPJ_UINT32)w || comp->h != (OPJ_UINT32)h ||
+			comp->x0 != jpx->x0 || comp->y0 != jpx->y0)
+			return 0;
+		/* indexed samples are copied as they are, like the generic path does */
+		if (!indexed && (comp->prec != 8 || comp->sgnd))
+			return 0;
+		src[k] = comp->data;
+	}
+
+	for (y = 0; y < h; y++)
+	{
+		unsigned char *d = dst + y * stride;
+		size_t row = (size_t)y * w;
+		if (comps == 1)
+		{
+			const OPJ_INT32 *s0 = src[0] + row;
+			for (x = 0; x < w; x++)
+				d[x] = (unsigned char)s0[x];
+		}
+		else if (comps == 3)
+		{
+			const OPJ_INT32 *s0 = src[0] + row;
+			const OPJ_INT32 *s1 = src[1] + row;
+			const OPJ_INT32 *s2 = src[2] + row;
+			for (x = 0; x < w; x++)
+			{
+				d[0] = (unsigned char)s0[x];
+				d[1] = (unsigned char)s1[x];
+				d[2] = (unsigned char)s2[x];
+				d += 3;
+			}
+		}
+		else
+		{
+			for (x = 0; x < w; x++)
+				for (k = 0; k < comps; k++)
+					*d++ = (unsigned char)src[k][row + x];
+		}
+	}
+	return 1;
+}
+
